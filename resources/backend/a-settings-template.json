{
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "workflowSizeGuideline": "small",
  "enableArtifact": false,
  "autoCompactEnabled": false,
  "autoScrollEnabled": false,
  "terminalProgressBarEnabled": false,
  "showTurnDuration": false,
  "useAutoModeDuringPlan": true,
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(ugrep /*)",
      "Bash(ugrep * /)",
      "Bash(ugrep * / *)",
      "Bash(bfs /*)",
      "Bash(bfs * /)",
      "Bash(bfs * / *)",
      "Bash(rg /*)",
      "Bash(rg * /)",
      "Bash(rg * / *)",
      "Bash(grep /*)",
      "Bash(grep * /)",
      "Bash(grep * / *)",
      "Bash(find /*)",
      "Bash(find * /)",
      "Bash(find * / *)",
      "Bash(fd /*)",
      "Bash(fd * /)",
      "Bash(fd * / *)",
      "Bash(grep -r / *)",
      "Bash(grep -R / *)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.local/bin/exchange_capture_hook.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.local/bin/ledger_hook.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.local/bin/ledger_hook.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.local/bin/ledger_hook.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
