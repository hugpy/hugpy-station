KEEPER_HOME = os.path.expanduser("~")


def _keeperify(argv):
    """Translate an lxc invocation aimed at the keeper console into a local command.
    None = not keeper-targeted; "__refuse__" = disallowed on the keeper console (lifecycle)."""
    if not argv or argv[0] != "lxc" or KEEPER_VM not in argv[1:3]:
        return None
    if len(argv) > 2 and argv[1] == "exec" and argv[2] == KEEPER_VM:
        rest = list(argv[3:])
        if rest[:1] == ["--"]:
            rest = rest[1:]
        while rest[:1] == ["sudo"]:          # drop "sudo -u ubuntu -H" shim
            rest = rest[4:]
        return [a.replace("/home/ubuntu", KEEPER_HOME) for a in rest]
    return "__refuse__"


def run(argv: list[str], timeout: float = 180,
        input: str | None = None) -> tuple[int, str]:
    local = _keeperify(argv)
    if local == "__refuse__":
        return 1, "refusing lifecycle action on the keeper console"
    if local is not None:
        argv = local
    try:
        p = subprocess.run(argv, capture_output=True, text=True,
                           timeout=timeout, input=input)
        return p.returncode, (p.stdout + p.stderr).strip()
    except subprocess.TimeoutExpired:
        return 124, f"timeout after {timeout}s"
    except Exception as exc:
        return 1, f"{type(exc).__name__}: {exc}"


def audit(rec: dict) -> None:
    rec = {"t": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "src": "console-api",
           **rec}
    try:
        AUDIT.parent.mkdir(parents=True, exist_ok=True)
        with open(AUDIT, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec) + "\n")
    except OSError:
        pass


def vm_rows() -> list[dict]:
    rc, out = run(["lxc", "list", "-c", "ns", "--format", "csv"], timeout=20)
    rows = []
    if rc == 0:
        for line in sorted(out.splitlines()):
            if "," in line:
                name, state = line.split(",", 1)
                rows.append({"name": name.strip(), "state": state.strip()})
    if all(r["name"] != KEEPER_VM for r in rows):
        rows.append({"name": KEEPER_VM, "state": "RUNNING"})
    return rows


def vm_state(name: str) -> str | None:
    for r in vm_rows():
        if r["name"] == name:
            return r["state"]
    return None


# Which tmux session each agent owns. They run SIDE BY SIDE (operator: the free
# local keeper stays available to absorb work the metered claude one would
# otherwise pay for), so they cannot share a session name.
# One EXPLICIT session per backend (operator, 2026-08-22) — MUST match
# BACKEND_TMUX_SESSION in server.py and the table in
# station-stack/opt/station-keeper/keeper-ensure.sh. The in-VM ensure creates
# `keeper-mct` (KEEPER_BACKEND=claude → `keeper-claude`).
AGENT_SESSION = {"mct": "keeper-mct", "claude": "keeper-claude", "hugpy": "keeper-local"}
# Legacy names still probed so a VM that has not been re-synced
# (station-stack-install) keeps reporting honestly instead of looking dead:
# `keeper` was the shared frontier name (mct or claude, whoever got there
# first); `keeper-hugpy` the local keeper before 2026-07-27.
AGENT_SESSION_ALT = {"mct": ["keeper"], "claude": ["keeper"], "hugpy": ["keeper-hugpy"]}

# Per-VM enable flags. Presence of the file == that agent may be (re)started by
# its timer. Only claude is gated: it spends metered tokens, the local keeper is
# free and is the fleet default.
GATE_DIR = "/opt/llm-station/keeper-agents.d"
GATEABLE = {"claude"}


def _sh(name: str, script: str, timeout: int = 15) -> tuple[int, str]:
    """Run a shell snippet in the VM as ubuntu. One place for the lxc-exec shape."""
    return run(["lxc", "exec", name, "--", "sudo", "-u", "ubuntu", "-H",
                "bash", "-lc", script], timeout=timeout)


def session_of(agent: str) -> str:
    return AGENT_SESSION.get(agent, "keeper-mct")


def keeper_session(name: str, agent: str = "claude") -> bool:
    """Is that agent's tmux session live?

    `-t =<sess>` is ANCHORED: tmux prefix-matches by default and `keeper` is a
    prefix of `keeper-local`, so an unanchored probe reports the claude keeper
    as live whenever only the local one is running. That silent misattribution
    is worse than a missing answer, so every target here carries the '='.
    """
    for sess in [session_of(agent)] + AGENT_SESSION_ALT.get(agent, []):
        rc, _ = run(["lxc", "exec", name, "--", "sudo", "-u", "ubuntu", "-H",
                     "tmux", "-L", "console", "has-session", "-t", "=" + sess],
                    timeout=15)
        if rc == 0:
            return True
    return False


def keeper_agent(name: str) -> str | None:
    # Which frontier agent is live, by its OWN named session (explicit wiring).
    # Legacy shared `keeper` session: read KEEPER_AGENT from the tmux session
    # environment (the hugpy ensure set it; the classic claude ensure set
    # nothing -> None -> the caller reports "claude").
    for agent in ("mct", "claude"):
        rc, _ = _sh(name, "tmux -L console has-session -t =" + AGENT_SESSION[agent] + " 2>/dev/null")
        if rc == 0:
            return agent
    rc, out = _sh(name,
                  "tmux -L console show-environment -t =keeper KEEPER_AGENT "
                  "2>/dev/null | sed -n 's/^KEEPER_AGENT=//p'")
    return (out.strip() or None) if rc == 0 else None


def keeper_gate(name: str) -> dict:
    """{agent: bool} — is each gateable agent allowed to (re)start on this VM?"""
    out_map = {}
    for agent in sorted(GATEABLE):
        rc, _ = _sh(name, f"test -e {GATE_DIR}/{agent}.enabled")
        out_map[agent] = (rc == 0)
    return out_map


def keeper_gate_set(name: str, agent: str, enabled: bool) -> tuple[int, str]:
    """Create/remove the enable flag. Disabling never kills a live session --
    it only stops the timer bringing the keeper back, which is the documented
    contract in that directory's README."""
    if enabled:
        script = f"mkdir -p {GATE_DIR} && touch {GATE_DIR}/{agent}.enabled"
    else:
        script = f"rm -f {GATE_DIR}/{agent}.enabled"
    return _sh(name, script)


def keeper_kill(name: str, agent: str = "claude") -> tuple[int, str]:
    # Tear down that agent's session (replace:true launches, and the UI's
    # explicit stop). ANCHORED: unanchored, killing "keeper" would destroy a
    # live `keeper-local` instead -- the most damaging form of the prefix bug.
    # Killing an absent session returns nonzero harmlessly (callers ignore rc).
    return run(["lxc", "exec", name, "--", "sudo", "-u", "ubuntu", "-H",
                "tmux", "-L", "console", "kill-session",
                "-t", "=" + session_of(agent)], timeout=15)


def keeper_launch(name: str) -> tuple[int, str]:
    # The in-VM ensure script starts the real keeper claude in the session
    # (idempotent; exits 0 when already running). It self-gates on
    # claude.enabled and says so on stderr when disabled -- which the launch
    # route surfaces verbatim rather than reporting a bare failure.
    return _sh(name,
               "for e in /opt/station-keeper/keeper-ensure.sh "
               "/opt/llm-station/keeper-ensure.sh; do "
               "[ -x \"$e\" ] && exec \"$e\" \"$(hostname)\"; done; "
               "echo 'no keeper-ensure script installed in this VM'; exit 2",
               timeout=60)


def keeper_launch_hugpy(name: str) -> tuple[int, str]:
    # Local-LLM keeper: same shape, its own ensure. HUGPY_KEEPER_SESSION is
    # passed explicitly so it builds ITS session even on a VM whose env file
    # has not been pinned yet -- otherwise it would claim the shared "keeper"
    # name and evict the claude keeper, which is the thing this split exists to
    # prevent. It tags the session env KEEPER_AGENT=hugpy so GET self-reports.
    sess = session_of("hugpy")
    return _sh(name,
               f"export HUGPY_KEEPER_SESSION={sess}; "
               "for e in /opt/station-keeper/hugpy-keeper-ensure.sh "
               "/opt/llm-station/hugpy-keeper-ensure.sh; do "
               "[ -x \"$e\" ] && exec \"$e\" \"$(hostname)\"; done; "
               "echo 'no hugpy-keeper-ensure script installed in this VM'; exit 2",
               timeout=60)


