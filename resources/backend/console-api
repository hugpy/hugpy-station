def _hugpy_env_read() -> dict:
    out = {}
    try:
        for line in HUGPY_ENV_FILE.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            out[k.strip()] = v.strip()
    except OSError:
        pass
    return out


def _hugpy_env_write(updates: dict) -> None:
    with _hugpy_cfg_lock:
        cur = _hugpy_env_read()
        cur.update(updates)
        HUGPY_ENV_FILE.parent.mkdir(parents=True, exist_ok=True)
        tmp = HUGPY_ENV_FILE.with_suffix(".tmp")
        tmp.write_text("".join(f"{k}={v}\n" for k, v in cur.items() if v))
        os.chmod(tmp, 0o600)
        tmp.replace(HUGPY_ENV_FILE)
        _HUGPY_CFG.update(cur)


