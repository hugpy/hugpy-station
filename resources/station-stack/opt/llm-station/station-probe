#!/bin/sh
# station-probe -- run this VM's post-condition probes and report pass/fail.
# Board p1 (accepted 2026-07-27): a fleet push must be able to prove its patch
# took EFFECT here, not merely that files were delivered. Intended to be invoked
# by the fleet installer after apply, and by any keeper on demand.
#
#   station-probe            human summary; exit 1 if any probe FAILs
#   station-probe --json     one JSON object; same exit semantics
#   station-probe <name>     run a single probe by name (with or without .probe)
#
# Probes live in probes.d/ -- see probes.d/README for the contract.
set -u
DIR="${STATION_PROBE_DIR:-/opt/llm-station/probes.d}"
JSON=0; ONLY=""
for a in "$@"; do
  case "$a" in
    --json) JSON=1 ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "station-probe: unknown option: $a" >&2; exit 2 ;;
    *)  ONLY="${a%.probe}" ;;
  esac
done
[ -d "$DIR" ] || { echo "station-probe: no probe dir: $DIR" >&2; exit 2; }

fails=0; total=0; first=1
[ "$JSON" -eq 1 ] && printf '{"host":"%s","probes":[' "$(hostname)"
for p in "$DIR"/*.probe; do
  [ -e "$p" ] || continue
  name=$(basename "$p" .probe)
  [ -n "$ONLY" ] && [ "$ONLY" != "$name" ] && continue
  desc=$(sed -n '2s/^# *desc: *//p' "$p")
  out=$(sh "$p" 2>&1); rc=$?
  total=$((total+1))
  [ "$rc" -eq 0 ] && st=PASS || { st=FAIL; fails=$((fails+1)); }
  if [ "$JSON" -eq 1 ]; then
    [ "$first" -eq 1 ] || printf ','; first=0
    esc=$(printf '%s' "$out" | tr '\n' ' ' | sed 's/\\/\\\\/g; s/"/\\"/g')
    printf '{"name":"%s","status":"%s","rc":%d,"detail":"%s"}' "$name" "$st" "$rc" "$esc"
  else
    printf '%-6s %-22s %s\n' "$st" "$name" "${desc:-}"
    [ -n "$out" ] && printf '       %s\n' "$out"
  fi
done
if [ "$JSON" -eq 1 ]; then
  printf '],"total":%d,"failed":%d}\n' "$total" "$fails"
else
  [ "$total" -eq 0 ] && { echo "station-probe: no probes matched" >&2; exit 2; }
  echo "-- $total probe(s), $fails failed"
fi
[ "$fails" -eq 0 ] || exit 1
exit 0
