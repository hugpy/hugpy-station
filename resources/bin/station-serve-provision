#!/usr/bin/env bash
# station-serve-provision — give THIS account (a locus) its own standing
# abstract-claude serve: the keeper/chat/worker/local sessions of the console,
# run AS this account, from the station's SHIPPED resources only (1.0.144).
#
# Operator 2026-10-01: "every locus needs a serve chat and a keeper — being the
# station's host should have no bearing." The station runs this script ON the
# target through its locus transport (locus_exec: bash -s on this host, ssh, or
# lxc exec), shipped on stdin from the station's own resources/bin — so it works
# on a locus whatever station version (if any) it has installed. It is also a
# plain CLI on a locus that has the package:
#
#   station-serve-provision [--instance station] [--locus NAME] [--port N]
#                           [--app-root DIR] [--no-start] [--json]
#
# Nothing here is hand-authored live state. Every artifact is DERIVED:
#   * the unit       = resources/systemd/abstract-claude-serve@.service, copied
#                      (station-serve-update's own install rule: a differing
#                      file is kept beside it as *.hand-<stamp>, never lost);
#   * the runner     = ~/.local/bin/abstract-claude-serve-run -> <app>/resources/bin
#                      (hugpy-station-firstrun's link, same target);
#   * the venv       = <state>/serve-venv, provisioned to resources/REQUIREMENTS.txt
#                      by the shipped station-provision-venv (PyPI pins);
#   * a state drop-in (only when the state dir is not ~/hugpy-station, which the
#                      template assumes) — generated, rewritten on every run;
#   * <state>/env/serve-<inst>.env — STATE (port, venv, locus); keys already
#                      there are never overwritten.
# The runner then renders this locus's per-session directives (directives.py
# --locus <locus>) and bakes the console UI on every start.
#
# Idempotent: an instance that is already active and answering /api/state is
# reported, not restarted. Never touches a tmux session. Prints ONE json line
# last (ok, port, unit, app, version, venv, state, steps[]).
set -uo pipefail
INST="${PROVISION_INSTANCE:-station}"
LOCUS="${PROVISION_LOCUS:-}"
WANT_PORT="${PROVISION_PORT:-}"
APP="${PROVISION_APP_ROOT:-}"
START="${PROVISION_START:-1}"
while [ $# -gt 0 ]; do
    case "$1" in
        --instance) INST="$2"; shift 2 ;;
        --locus) LOCUS="$2"; shift 2 ;;
        --port) WANT_PORT="$2"; shift 2 ;;
        --app-root) APP="$2"; shift 2 ;;
        --no-start) START=0; shift ;;
        --json) shift ;;
        -h|--help) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "station-serve-provision: unknown arg $1" >&2; exit 2 ;;
    esac
done
[[ "$INST" =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo '{"ok":false,"error":"bad instance name"}'; exit 2; }
[ -z "$LOCUS" ] || [[ "$LOCUS" =~ ^[A-Za-z0-9_.-]{1,63}$ ]] || { echo '{"ok":false,"error":"bad locus name"}'; exit 2; }
[ -z "$WANT_PORT" ] || [[ "$WANT_PORT" =~ ^[0-9]{2,5}$ ]] || { echo '{"ok":false,"error":"bad port"}'; exit 2; }

STEPS=()
step() { STEPS+=("$*"); echo "station-serve-provision: $*" >&2; }
jstr() { python3 -c 'import json,sys;print(json.dumps(sys.argv[1]))' "$1"; }
finish() {   # finish ok error
    local s="" i
    for i in "${STEPS[@]}"; do s="${s:+$s,}$(jstr "$i")"; done
    printf '{"ok":%s,"error":%s,"instance":%s,"locus":%s,"user":%s,"host":%s,"state":%s,"app":%s,"version":%s,"venv":%s,"port":%s,"unit":%s,"active":%s,"healthy":%s,"steps":[%s]}\n' \
        "$1" "$(jstr "${2:-}")" "$(jstr "$INST")" "$(jstr "$LOCUS")" "$(jstr "$(id -un)")" \
        "$(jstr "$(hostname -s 2>/dev/null || hostname)")" "$(jstr "${S:-}")" "$(jstr "${APP:-}")" \
        "$(jstr "${VER:-}")" "$(jstr "${VENV:-}")" "${PORT:-0}" "$(jstr "$UNIT")" \
        "${ACTIVE:-false}" "${HEALTHY:-false}" "$s"
    [ "$1" = true ] && exit 0 || exit 1
}
UNIT="abstract-claude-serve@$INST.service"
ACTIVE=false; HEALTHY=false

# ── 0. this locus's station state dir (locus_exec.STATE_SH, the same rule) ────
S="${HUGPY_STATION_STATE:-}"
if [ -z "$S" ] && [ -r "$HOME/.config/hugpy-station/state-dir" ]; then
  S="$(head -n1 "$HOME/.config/hugpy-station/state-dir" 2>/dev/null)"; fi
if [ -z "$S" ] && [ -d "$HOME/hugpy-station/env" ]; then S="$HOME/hugpy-station"; fi
S="${S:-$HOME/.config/hugpy-station}"
mkdir -p "$S/env" "$S/logs" || finish false "cannot create $S"
chmod 700 "$S/env" 2>/dev/null || true
SENV="$S/env/serve-$INST.env"
senv_get() { [ -r "$SENV" ] && sed -n "s/^$1=//p" "$SENV" | tail -1 | sed 's/^"\(.*\)"$/\1/'; }
senv_put() {   # add a key only when absent — existing keys (operator/state) win
    [ -n "$(senv_get "$1")" ] && return 0
    printf '%s="%s"\n' "$1" "$2" >> "$SENV"; chmod 600 "$SENV"; step "serve-$INST.env: $1=$2"
}
[ -n "$LOCUS" ] || LOCUS="$(senv_get EXCHANGE_LOCUS)"
if [ -z "$LOCUS" ]; then
  for f in "$S/env/station.env" "$S/env/toolserver.env" "$S/toolserver.env"; do
    [ -r "$f" ] && LOCUS="$(sed -n 's/^STATION_LOCUS=//p' "$f" | tail -1 | tr -d '"')" && [ -n "$LOCUS" ] && break
  done
fi

# ── 1. the shipped station resources ON this locus ──────────────────────────
if [ -z "$APP" ]; then
  for a in "$S/app/current" /opt/hugpy-station; do
    if [ -x "$a/resources/bin/abstract-claude-serve-run" ] && [ -f "$a/resources/systemd/abstract-claude-serve@.service" ]; then
      APP="$a"; break
    fi
  done
fi
[ -n "$APP" ] && [ -x "$APP/resources/bin/abstract-claude-serve-run" ] \
  || finish false "no hugpy-station install on $(id -un)@$(hostname -s): need <state>/app/current or /opt/hugpy-station with resources/bin/abstract-claude-serve-run (install the station package on this locus)"
VER="$(cat "$APP/resources/VERSION" 2>/dev/null || echo '?')"
step "station resources: $APP ($VER)"

# ── 2. systemd user manager (the unit is a USER unit, like the keeper's) ─────
[ -n "${XDG_RUNTIME_DIR:-}" ] || export XDG_RUNTIME_DIR="/run/user/$(id -u)"
if ! systemctl --user show-environment >/dev/null 2>&1; then
  finish false "no systemd user manager for $(id -un) (enable lingering once, as root: loginctl enable-linger $(id -un))"
fi

port_free() { ! (ss -ltnH 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$1\$"); }
api_ok() { curl -s -m 4 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$1/api/state" 2>/dev/null | grep -q '^200$'; }

# ── 3. already provisioned and healthy? report, never restart ────────────────
PORT="$(senv_get AC_PORT)"
if systemctl --user is-active --quiet "$UNIT" 2>/dev/null; then
  ACTIVE=true
  if [ -n "$PORT" ] && api_ok "$PORT"; then
    HEALTHY=true; VENV="$(dirname "$(dirname "$(senv_get ABSTRACT_CLAUDE_BIN)")")"
    step "$UNIT already active and answering on 127.0.0.1:$PORT — nothing changed"
    finish true ""
  fi
fi

# ── 4. abstract-claude: a dedicated serve venv provisioned to the station pins ─
AC="$(senv_get ABSTRACT_CLAUDE_BIN)"
if [ -n "$AC" ] && [ -x "$AC" ]; then
  VENV="$(cd "$(dirname "$(readlink -f "$AC")")/.." && pwd)"
  step "abstract-claude: $AC (from serve-$INST.env)"
else
  VENV="$S/serve-venv"
  if [ ! -x "$VENV/bin/pip" ]; then
    python3 -m venv "$VENV" >/dev/null 2>&1 || finish false "python3 -m venv $VENV failed (python3-venv missing?)"
    step "created $VENV"
  fi
  "$APP/resources/bin/station-provision-venv" "$VENV" >&2
  AC="$VENV/bin/abstract-claude"
  [ -x "$AC" ] || finish false "abstract-claude not installed in $VENV (PyPI unreachable? see station-provision-venv output)"
fi
"$VENV/bin/python" -c 'import abstract_serve_core, abstract_claude' 2>/dev/null \
  || finish false "$VENV cannot import abstract_serve_core/abstract_claude"
step "venv $VENV: $("$AC" --version 2>/dev/null | head -1)"

# ── 5. per-instance settings (STATE): only missing keys are added ────────────
if [ -z "$PORT" ]; then
  p="${WANT_PORT:-9125}"
  while ! port_free "$p"; do p=$((p+1)); [ "$p" -lt 9400 ] || finish false "no free port in 9125..9399"; done
  PORT="$p"
fi
if [ ! -s "$SENV" ]; then
  printf '# serve-%s.env — per-instance settings for the shipped abstract-claude-serve-run\n# (STATE: written by station-serve-provision; keys already here are never overwritten)\n' "$INST" > "$SENV"
fi
chmod 600 "$SENV"
senv_put ABSTRACT_CLAUDE_BIN "$AC"
senv_put AC_HOST "127.0.0.1"
senv_put AC_PORT "$PORT"
senv_put AC_UI_BASE "/ac"
senv_put AC_SESSION_LABEL "keeper-serve"
senv_put AC_USAGE_BACKEND "toolserver"
[ -n "$LOCUS" ] && senv_put EXCHANGE_LOCUS "$LOCUS"
PORT="$(senv_get AC_PORT)"

# ── 6. the shipped unit + runner link (+ a generated state drop-in) ──────────
UD="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$UD" "$HOME/.local/bin"
TPL="$APP/resources/systemd/abstract-claude-serve@.service"; DST="$UD/abstract-claude-serve@.service"
if ! cmp -s "$TPL" "$DST" 2>/dev/null; then
  [ -f "$DST" ] && cp -p "$DST" "$DST.hand-$(date +%Y%m%d%H%M%S)" && step "kept the previous $DST as .hand-*"
  cp "$TPL" "$DST" && step "installed the shipped unit $DST"
fi
RUN="$HOME/.local/bin/abstract-claude-serve-run"
if [ "$(readlink -f "$RUN" 2>/dev/null)" != "$(readlink -f "$APP/resources/bin/abstract-claude-serve-run")" ]; then
  ln -sfn "$APP/resources/bin/abstract-claude-serve-run" "$RUN" && step "linked $RUN -> $APP/resources/bin"
fi
DROP="$UD/abstract-claude-serve@$INST.service.d"; DF="$DROP/10-station-state.conf"
if [ "$(readlink -f "$S")" != "$(readlink -f "$HOME/hugpy-station" 2>/dev/null || echo "$HOME/hugpy-station")" ]; then
  mkdir -p "$DROP"
  want="# generated by station-serve-provision ($VER) — rewritten on every provision; do not edit.
# The shipped template pins HUGPY_STATION_STATE=%h/hugpy-station; this locus keeps
# its station state at $S.
[Service]
Environment=HUGPY_STATION_STATE=$S
EnvironmentFile=-$S/env/station.env
EnvironmentFile=-$S/env/toolserver.env"
  if [ "$(cat "$DF" 2>/dev/null)" != "$want" ]; then printf '%s\n' "$want" > "$DF"; step "wrote state drop-in $DF"; fi
elif [ -f "$DF" ]; then
  rm -f "$DF"; rmdir "$DROP" 2>/dev/null || true; step "removed a stale state drop-in"
fi
systemctl --user daemon-reload

[ "$START" = 1 ] || { step "--no-start: unit installed, not started"; finish true ""; }

# ── 7. enable + start, wait for /api/state ───────────────────────────────────
systemctl --user enable "$UNIT" >/dev/null 2>&1 && step "enabled $UNIT"
if systemctl --user is-active --quiet "$UNIT"; then
  systemctl --user restart "$UNIT"; step "restarted $UNIT (it was active but not answering)"
else
  systemctl --user start "$UNIT"; step "started $UNIT"
fi
for _ in $(seq 1 90); do
  if api_ok "$PORT"; then HEALTHY=true; break; fi
  systemctl --user is-failed --quiet "$UNIT" && break
  sleep 2
done
systemctl --user is-active --quiet "$UNIT" && ACTIVE=true
if [ "$HEALTHY" = true ]; then
  step "serve answering on 127.0.0.1:$PORT"
  finish true ""
fi
step "journal: $(journalctl --user -u "$UNIT" -n 12 --no-pager 2>/dev/null | tail -12 | tr '\n' '|' | cut -c1-900)"
finish false "$UNIT did not answer /api/state on 127.0.0.1:$PORT"
