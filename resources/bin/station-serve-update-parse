#!/usr/bin/env python3
"""station-serve-update-parse <legacy run-<instance>.sh> <instance> -> serve-<instance>.env on stdout.

Reads the values a hand-written serve launcher exported and writes them as the
instance env the shipped runner (abstract-claude-serve-run) loads. Only a known
set of keys is carried; tokens are NEVER copied (they come from the locus's
station/toolserver env). Handles `export K=V`, `export K="${K:-V}"`, shell
variables defined earlier in the script (`STATE=...` then `$STATE/...`), the
hugpy B gateway (`B_GATEWAY="${AC_B_GATEWAY:-URL}"`), the exec'd venv binary and
whether the launcher baked the web UI (no bake step -> AC_UI_BAKE=0).
"""
import re
import sys

KEYS = ("AC_ROOT", "AC_HOST", "AC_PORT", "AC_UI_BASE", "AC_UI_DIST", "EXCHANGE_LOCUS",
        "EXCHANGE_INGEST_URL", "AC_SESSION_LABEL", "AC_USAGE_BACKEND")
_ASSIGN = re.compile(r'^\s*(?:export\s+)?([A-Z_][A-Z0-9_]*)=(.*?)\s*(?:#.*)?$')
_DEFAULT = re.compile(r'^"?\$\{([A-Z_][A-Z0-9_]*):-(.*)\}"?$')


def _unquote(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
        v = v[1:-1]
    return v


def parse(text):
    shell, out = {}, {}
    for ln in text.splitlines():
        s = ln.strip()
        if not s or s.startswith("#"):
            continue
        m = _ASSIGN.match(s)
        if not m or "$(" in m.group(2):
            continue
        k, raw = m.group(1), m.group(2).strip()
        d = _DEFAULT.match(raw)
        v = _unquote(d.group(2)) if d else _unquote(raw)
        v = re.sub(r"\$\{?([A-Z_][A-Z0-9_]*)\}?", lambda mm: shell.get(mm.group(1), mm.group(0)), v)
        shell[k] = v
        if k in KEYS:
            out[k] = v
        elif k == "B_GATEWAY" and d and d.group(1) == "AC_B_GATEWAY":
            out["AC_B_GATEWAY"] = v
    m = re.search(r"^\s*exec\s+(\S*/bin/abstract-claude)\b", text, re.M)
    if m:
        out["ABSTRACT_CLAUDE_BIN"] = m.group(1)
    if "station-bake-webui" not in text:
        out["AC_UI_BAKE"] = "0"
    return out


def main(argv):
    path, inst = argv[1], argv[2]
    vals = parse(open(path, encoding="utf-8").read())
    print("# serve-%s.env — per-instance settings for the shipped abstract-claude-serve-run" % inst)
    print("# migrated by station-serve-update from %s (1.0.128). Edit here, never in a launcher." % path)
    for k in sorted(vals):
        print('%s="%s"' % (k, vals[k].replace('"', '\\"')))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
