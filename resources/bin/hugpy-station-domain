#!/usr/bin/env bash
# hugpy-station-domain — publish this machine's fleet console at a domain.
#
# What it wires (each step idempotent):
#   1. the HEADLESS console: systemd unit hugpy-station-web@<user> — the
#      packaged backend on 127.0.0.1:8898, always-on (no desktop app needed),
#      login REQUIRED (the unit refuses to start without a password);
#   2. nginx: a reverse-proxy site for the domain — websocket upgrades (the
#      terminals), X-Real-IP, SSE-friendly buffering, big uploads;
#   3. TLS: a Let's Encrypt certificate via certbot --nginx (http-01: the
#      domain's A/AAAA record must already point at this machine).
#
# The console password comes FIRST: set it in the app's 🌐 browser access
# panel (steward drawer) — this script refuses to publish an open console.
#
# Usage: sudo hugpy-station-domain <domain> [--user <login>] [--port 8898]
#                                  [--no-cert] [--print-nginx]
#   --user       account the headless console runs as (default: who ran sudo)
#   --port       loopback port the headless console binds (default 8898)
#   --no-cert    skip certbot (serve plain http on :80 — for testing only)
#   --print-nginx  print the nginx site config and exit (no root needed)
set -euo pipefail
log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
die() { echo "error: $*" >&2; exit 1; }

DOMAIN=""; RUN_USER="${SUDO_USER:-}"; PORT=8898; DO_CERT=1; PRINT=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --user) RUN_USER="$2"; shift 2;;
    --port) PORT="$2"; shift 2;;
    --no-cert) DO_CERT=0; shift;;
    --print-nginx) PRINT=1; shift;;
    -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    --*) die "unknown option: $1";;
    *) DOMAIN="$1"; shift;;
  esac
done
[ -n "$DOMAIN" ] || die "usage: hugpy-station-domain <domain> (see --help)"
[[ "$DOMAIN" =~ ^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$ ]] || die "not a valid domain: $DOMAIN"
[[ "$PORT" =~ ^[0-9]+$ ]] || die "--port must be a number"
[ -n "$RUN_USER" ] || RUN_USER="$(getent passwd 1000 | cut -d: -f1)"
[ -n "$RUN_USER" ] || die "no --user given and no uid-1000 account found"

nginx_conf() {
  cat <<CONF
# hugpy-station @ $DOMAIN -> 127.0.0.1:$PORT (hugpy-station-web@$RUN_USER)
# generated by hugpy-station-domain; certbot rewrites this for TLS.
server {
    listen 80;
    listen [::]:80;
    server_name $DOMAIN;

    # the terminals are websockets; keep them open for days
    proxy_http_version 1.1;
    proxy_set_header Upgrade \$http_upgrade;
    proxy_set_header Connection \$fc_connection_upgrade;
    proxy_read_timeout 7d;
    proxy_send_timeout 7d;

    # the console trusts X-Real-IP for the true client (rate-limits, audit)
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header Host \$host;

    # file-browser uploads are large; chat/relay streams must not buffer
    client_max_body_size 4g;
    proxy_buffering off;
    proxy_request_buffering off;

    location / {
        proxy_pass http://127.0.0.1:$PORT;
    }
}
CONF
}

if [ "$PRINT" = 1 ]; then nginx_conf; exit 0; fi
[ "$(id -u)" = 0 ] || die "run with sudo (installs nginx site + systemd unit)"

HOME_DIR="$(getent passwd "$RUN_USER" | cut -d: -f6)"
[ -n "$HOME_DIR" ] || die "unknown user: $RUN_USER"
AUTH_FILE="$HOME_DIR/.config/hugpy-station/.auth"
[ -s "$AUTH_FILE" ] \
  || die "no console password set for '$RUN_USER' — open the console's 🌐 browser
access panel (steward drawer) and set one first; a domain must never serve open"

# DNS sanity (advisory: certbot is the real arbiter)
if command -v getent >/dev/null 2>&1 && ! getent hosts "$DOMAIN" >/dev/null 2>&1; then
  log "WARNING: '$DOMAIN' does not resolve from here yet — point its A/AAAA record at this machine or certbot will fail"
fi

log "1/3 headless console: hugpy-station-web@$RUN_USER (127.0.0.1:$PORT)"
systemctl daemon-reload
if [ "$PORT" != 8898 ]; then
  mkdir -p "/etc/systemd/system/hugpy-station-web@$RUN_USER.service.d"
  printf '[Service]\nEnvironment=PORT=%s\n' "$PORT" \
    > "/etc/systemd/system/hugpy-station-web@$RUN_USER.service.d/port.conf"
  systemctl daemon-reload
fi
systemctl enable --now "hugpy-station-web@$RUN_USER"
sleep 2
systemctl is-active --quiet "hugpy-station-web@$RUN_USER" \
  || die "hugpy-station-web@$RUN_USER failed to start — journalctl -u hugpy-station-web@$RUN_USER"

log "2/3 nginx site for $DOMAIN"
if ! command -v nginx >/dev/null 2>&1; then
  log "  installing nginx"
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nginx
fi
# the websocket Connection map lives at http{} scope, shipped once (own name
# so it can never collide with another site's map)
cat > /etc/nginx/conf.d/hugpy-station-upgrade.conf <<'MAP'
map $http_upgrade $fc_connection_upgrade {
    default upgrade;
    ''      close;
}
MAP
nginx_conf > "/etc/nginx/sites-available/hugpy-station-$DOMAIN.conf"
ln -sf "/etc/nginx/sites-available/hugpy-station-$DOMAIN.conf" \
       "/etc/nginx/sites-enabled/hugpy-station-$DOMAIN.conf"
nginx -t
systemctl enable --now nginx
systemctl reload nginx

if [ "$DO_CERT" = 1 ]; then
  log "3/3 TLS: certbot --nginx -d $DOMAIN"
  if ! command -v certbot >/dev/null 2>&1; then
    log "  installing certbot"
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq certbot python3-certbot-nginx
  fi
  certbot --nginx -d "$DOMAIN" --redirect \
    || die "certbot failed — is the domain's A record pointing here and port 80 reachable? Re-run when it is."
  echo
  log "done: https://$DOMAIN (login: admin + the console password)"
else
  echo
  log "done (no cert): http://$DOMAIN — TESTING ONLY, the login travels in clear"
fi
log "headless console: systemctl status hugpy-station-web@$RUN_USER"
exit 0
