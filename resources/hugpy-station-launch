#!/bin/bash
# hugpy Station launcher — the .desktop / /usr/bin entry point.
# Installed to /opt/hugpy-station/hugpy-station-launch (mode 755); postinst
# points the `hugpy-station` alternative here, never at the raw Electron
# binary (it crashes from a shell: zygote sandbox + space in path).
#
# 1.0.42: this file is now SOURCE (station-app/resources/); it used to live
# only in the build root. Changes: --version/--help answered before Electron
# is touched; no display -> clear error, exit 2 (Electron used to SIGSEGV on
# its own exit path over ssh); the backend interpreter is probed for aiohttp
# instead of trusting whatever `python3` is first on PATH (conda shadowing
# produced a window with ERR_CONNECTION_REFUSED and a dead backend).

# --- where am I? -------------------------------------------------------------
# 1.0.42 (packaging revamp): this same script is installed under TWO names —
#   /opt/hugpy-station/hugpy-station-launch   (deb / rpm / pacman entry point)
#   <AppDir>/AppRun                           (AppImage entry point)
# so APP_ROOT is derived, never hardcoded. $0 may be reached through
# /usr/bin/hugpy-station -> /etc/alternatives/hugpy-station -> here, hence
# readlink -f. The /opt fallback keeps a hand-copied launcher working.
if [ -n "${APPDIR:-}" ] && [ -x "$APPDIR/hugpy-station" ]; then
    APP_ROOT="$APPDIR"
else
    _self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
    APP_ROOT="$(cd "$(dirname "$_self")" 2>/dev/null && pwd)"
    [ -n "$APP_ROOT" ] && [ -x "$APP_ROOT/hugpy-station" ] || APP_ROOT="/opt/hugpy-station"
fi
BIN="$APP_ROOT/hugpy-station"

station_version() {
    if [ -r "$APP_ROOT/resources/VERSION" ]; then
        tr -d '[:space:]' < "$APP_ROOT/resources/VERSION"
    elif [ -r "$APP_ROOT/resources/app.asar" ]; then
        # asar stores package.json uncompressed; the first match is the app's.
        grep -ao '"version": *"[0-9][0-9A-Za-z.+-]*"' "$APP_ROOT/resources/app.asar" \
            | head -1 | sed -E 's/.*"([^"]+)"$/\1/'
    else
        echo "unknown"
    fi
}

# --- CLI answered in-shell, BEFORE the log redirect and BEFORE Electron -----
case "${1:-}" in
    --version|-V|version)
        echo "hugpy-station $(station_version)"
        exit 0 ;;
    --help|-h|help)
        cat <<EOF
hugpy-station $(station_version) — hugpy Station desktop cockpit

usage: hugpy-station [--version] [--help] [electron/chromium switches...]

Needs a graphical session (\$DISPLAY or \$WAYLAND_DISPLAY). Launch log:
  \${XDG_CACHE_HOME:-~/.cache}/hugpy-station-launch.log
Environment:
  CONSOLE_PORT            backend port (default 8899; when it is held by something
                          that is not a stale station backend, the next free port)
  HUGPY_STATION_PYTHON    interpreter for the backend (must import aiohttp)
  FLEETVIEW_TERM_CMD, KEEPER_DEFAULT_BACKEND   see station docs
EOF
        exit 0 ;;
esac

# --- AppImage: the environment the stock AppRun would have set --------------
# We REPLACE electron-builder's generated AppRun with this script so the
# preflights above/below run inside the AppImage too. Everything the stock
# AppRun exports is reproduced here EXCEPT LD_LIBRARY_PATH: $APPDIR/usr/lib
# holds the AppImage runtime's own libraries, and the backend we spawn is the
# SYSTEM python3 — pointing it at those libs is how you get an import error
# that looks like a bug in server.py. Electron itself resolves via $ORIGIN.
if [ -n "${APPDIR:-}" ]; then
    export PATH="${APPDIR}:${APPDIR}/usr/sbin${PATH:+:$PATH}"
    export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share/:/usr/share/}"
    [ -d "${APPDIR}/usr/share/glib-2.0/schemas" ] && \
        export GSETTINGS_SCHEMA_DIR="${APPDIR}/usr/share/glib-2.0/schemas"
    export APPIMAGE="${APPIMAGE:-$APPDIR/AppRun}"
fi

# --- preflight: display ------------------------------------------------------
if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    echo "hugpy-station: no graphical display (\$DISPLAY and \$WAYLAND_DISPLAY are" \
         "unset; session type: ${XDG_SESSION_TYPE:-unknown})." >&2
    echo "  Start it from the desktop session, or over ssh -X, or under xvfb-run." >&2
    echo "  (--version / --help work without a display.)" >&2
    exit 2
fi

# --- preflight: backend interpreter -----------------------------------------
# The backend (resources/backend/server.py) needs aiohttp. Prefer an
# interpreter that has it natively (system python3-aiohttp); otherwise accept
# one that can import it from the vendored copy shipped in the package
# (resources/backend/vendor, compiled for Ubuntu noble / py3.12).
# A conda/pyenv `python3` first on PATH may lack it or carry a half-installed
# copy. The chosen interpreter is exported for main.js.
VENDOR_DIR="$APP_ROOT/resources/backend/vendor"
pick_python() {
    local cand
    for cand in "${HUGPY_STATION_PYTHON:-}" /usr/bin/python3 /usr/local/bin/python3 \
                "$(command -v python3 2>/dev/null)" "$(command -v python 2>/dev/null)"; do
        [ -n "$cand" ] && [ -x "$cand" ] || continue
        if "$cand" -c 'import aiohttp' >/dev/null 2>&1; then
            echo "$cand"; return 0
        fi
        if [ -d "$VENDOR_DIR" ] && PYTHONPATH="$VENDOR_DIR" "$cand" -c 'import aiohttp' >/dev/null 2>&1; then
            echo "$cand"; return 0
        fi
    done
    return 1
}
if ! PY="$(pick_python)"; then
    echo "hugpy-station: no Python interpreter with aiohttp found (tried" \
         "\$HUGPY_STATION_PYTHON, /usr/bin/python3, python3 on PATH)." >&2
    echo "  Install it for the interpreter you want:  /usr/bin/python3 -m pip install aiohttp" >&2
    echo "  (Debian/Ubuntu: apt install python3-aiohttp; Fedora: dnf install python3-aiohttp)" >&2
    echo "  or point HUGPY_STATION_PYTHON at one that has it." >&2
    exit 3
fi
export HUGPY_STATION_PYTHON="$PY"
# vendored fallback engages only when the interpreter lacks aiohttp natively
if ! "$PY" -c 'import aiohttp' >/dev/null 2>&1; then
    export PYTHONPATH="$VENDOR_DIR${PYTHONPATH:+:$PYTHONPATH}"
fi

# --- from here on, everything goes to the launch log -------------------------
# fd 3 keeps the caller's stderr for the few messages a person must see.
exec 3>&2
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
mkdir -p "$LOG_DIR" 2>/dev/null
exec >>"$LOG_DIR/hugpy-station-launch.log" 2>&1
echo "=== launch $(date '+%F %T') === version $(station_version) python $PY args: $*"

# --- mode --------------------------------------------------------------------
# `hugpy-station --serve [claude|gpt|hugpy]` is a CLIENT of serve (main.js hands
# it to resources/serve-app: join this user's running serve, else start serve
# only). It runs no backend and binds no station port, so it has no business
# with the station port at all: nothing below may touch any process in that mode.
SERVE_MODE=0
for _a in "$@"; do
    case "$_a" in --serve|--serve=*) SERVE_MODE=1 ;; esac
done

# --- station port: join / pick another port, NEVER a blind kill (1.0.139) ----
# Until 1.0.138 a busy port meant `pkill -f hugpy-station/hugpy-station`,
# `pkill -f resources/backend/server.py` and `fuser -k -9 <port>/tcp`: every
# same-user station, every headless hugpy-station-web@ backend (whatever its
# port; its clean exit left Restart=on-failure down) and whoever held the port.
# serve-core's auto-open ran `hugpy-station --serve claude` from the station's
# own serve, so ~1 station launch in 3 killed itself. Now only the LISTENER on
# the station port is examined, and:
#   * a live Station of this user owns it   -> exec Electron anyway: main.js
#     holds the single-instance lock, so the new process focuses the running
#     window and quits (a stopped (^Z) one cannot answer: say so, exit 4);
#   * a backend whose desktop Station is gone (HUGPY_STATION_DESKTOP_PID in its
#     env names a dead pid — main.js sets it) -> stale: that ONE pid is reaped;
#   * anything else (the headless hugpy-station-web@ unit, another user, a
#     hand-run server.py, a station older than 1.0.139) is left alone and this
#     Station takes the next free port.
PORT="${CONSOLE_PORT:-8899}"

port_busy() { ss -ltn "sport = :$1" 2>/dev/null | grep -q '^LISTEN'; }
port_pids() {  # same-user listener pids on $1 (other users' are not visible)
    ss -ltnp "sport = :$1" 2>/dev/null | grep '^LISTEN' | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -un
}
proc_argv0() { tr '\0' '\n' < "/proc/$1/cmdline" 2>/dev/null | head -1; }
proc_state() { sed -n 's/^State:[[:space:]]*\([A-Za-z]\).*/\1/p' "/proc/$1/status" 2>/dev/null; }
proc_ppid()  { sed -n 's/^PPid:[[:space:]]*//p' "/proc/$1/status" 2>/dev/null; }
proc_env()   { tr '\0' '\n' < "/proc/$1/environ" 2>/dev/null | sed -n "s/^$2=//p" | head -1; }
is_backend() { tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -q 'resources/backend/server\.py'; }
# a Station Electron MAIN process: its binary (or argv[0]) is .../hugpy-station,
# not a --type= helper, not a --serve client. NB Chromium rewrites the main
# process's /proc/<pid>/cmdline into ONE space-joined string
# ("/opt/hugpy-station/hugpy-station --disable-gpu ... --no-sandbox"), so argv[0]
# is cut at the first space and the flags are split on NULs AND spaces. Without
# that a live Station was not recognised and its own backend was reaped as
# "stale" (1.0.139 VM test, caught before release).
is_station() {
    [ -n "$1" ] && [ -r "/proc/$1/cmdline" ] || return 1
    local exe a0
    exe="$(basename "$(readlink "/proc/$1/exe" 2>/dev/null)" 2>/dev/null)"
    a0="$(basename "$(proc_argv0 "$1" | cut -d' ' -f1)" 2>/dev/null)"
    [ "$exe" = hugpy-station ] || [ "$a0" = hugpy-station ] || return 1
    ! tr '\0 ' '\n\n' < "/proc/$1/cmdline" 2>/dev/null | grep -qE '^--(type=|serve$|serve=)'
}
next_free_port() {
    local p=$(( $1 + 1 )) last=$(( $1 + 40 ))
    while [ "$p" -le "$last" ]; do
        port_busy "$p" || { echo "$p"; return 0; }
        p=$(( p + 1 ))
    done
    return 1
}
say_user() { echo "hugpy-station: $*"; echo "hugpy-station: $*" >&3; }

if [ "$SERVE_MODE" = 1 ]; then
    echo "serve mode: client of this user's serve — the station port and every running process are left alone"
elif port_busy "$PORT"; then
    pids="$(port_pids "$PORT")"
    [ -n "$pids" ] || echo "port $PORT is held by a listener this user cannot see (another user / root) — left alone"
    for pid in $pids; do
        ppid="$(proc_ppid "$pid")"
        if is_station "$pid"; then
            holder="$pid"
        elif is_backend "$pid" && is_station "$ppid"; then
            holder="$ppid"
        else
            holder=""
        fi
        if [ -n "$holder" ]; then
            if [ "$(proc_state "$holder")" = T ]; then
                say_user "a hugpy Station (pid $holder) is already running but STOPPED (^Z) — resume it (kill -CONT $holder) or close it; not starting a second one."
                command -v notify-send >/dev/null 2>&1 && notify-send "hugpy Station" \
                    "Station pid $holder is stopped (^Z). Resume it (kill -CONT $holder) or close it." >/dev/null 2>&1
                exit 4
            fi
            echo "port $PORT: hugpy Station pid $holder is running — handing off to it (single-instance: the new window focuses the running one)"
            continue
        fi
        if is_backend "$pid"; then
            dpid="$(proc_env "$pid" HUGPY_STATION_DESKTOP_PID)"
            if [ -n "$dpid" ] && ! is_station "$dpid"; then
                echo "port $PORT: pid $pid is a stale station backend (its desktop Station $dpid is gone) — reaping that one pid"
                kill -TERM "$pid" 2>/dev/null
                for _ in 1 2 3 4 5 6; do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
                if kill -0 "$pid" 2>/dev/null; then   # a stopped (^Z) holder ignores TERM
                    kill -CONT "$pid" 2>/dev/null; kill -KILL "$pid" 2>/dev/null; sleep 0.5
                fi
                continue
            fi
            echo "port $PORT: pid $pid is a station backend NOT owned by a desktop Station (headless hugpy-station-web@ / hand-run / pre-1.0.139) — left alone"
        else
            echo "port $PORT: held by pid $pid ($(proc_argv0 "$pid")) — not a station process, left alone"
        fi
    done
    if port_busy "$PORT"; then
        if np="$(next_free_port "$PORT")"; then
            echo "port $PORT stays in use — this Station's backend takes port $np"
            PORT="$np"
        else
            say_user "port $PORT and the 40 ports above it are in use — set CONSOLE_PORT to a free port."
            exit 5
        fi
    fi
    export CONSOLE_PORT="$PORT"
fi

export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}"
# 1.0.85: no default for FLEETVIEW_TERM_CMD any more. The old default
# ("hugpy-agent mct" = the DEPRECATED broker, mct-deprecated in NOMENCLATURE)
# silently replaced the frontier default backend (claude-code) on every
# host-grounded launch: the UI said claude-code, the tmux pane ran the old
# REPL, board nudges never found a ❯ prompt and the seat had no MCP bridge.
# The knob stays an OPT-IN override ("claude" = the templated Claude Code
# seat, or any command); unset = TERM_SURFACES defaults.
[ -n "${FLEETVIEW_TERM_CMD:-}" ] && export FLEETVIEW_TERM_CMD

# 1.0.85: abstract-claude's fresh-session default is "wipe" — DELETE the seat
# user's ~/.claude and rebuild it on every claude-code seat launch (operator
# ruling 2026-09-04, meant for fleet accounts that ARE the seat). On a desktop
# the same account is the operator's own Claude Code user: its auto-memory and
# transcripts live in that ~/.claude and were erased at every seat launch.
# abstract-claude reads its config from $AC_ROOT/config.json (default
# /srv/abstract_claude). Where that fleet root is absent and the user keeps
# a private root with a config.json (fresh_session_mode "dir" = a brand-new
# ~/.claude-sessions/<stamp> per launch, ~/.claude untouched), point the seats
# at it. An explicit AC_ROOT always wins; fleet hosts are unaffected.
if [ -z "${AC_ROOT:-}" ] && [ ! -e /srv/abstract_claude/config.json ] \
   && [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/abstract_claude/config.json" ]; then
    export AC_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/abstract_claude"
fi
export KEEPER_DEFAULT_BACKEND="${KEEPER_DEFAULT_BACKEND:-hugpy-agent::claude-code}"

ARGS=(--disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --no-sandbox)
# lxd access: if this session lacks the lxd group but the user is a member,
# re-exec through sg so `lxc` works without a re-login (restored from 1.0.6 —
# without it every keeper `lxc exec` fails and claude keepers cannot start).
if ! id -nG | grep -qw lxd && getent group lxd | grep -qw "$USER" \
   && command -v sg >/dev/null 2>&1; then
    echo "re-exec via sg lxd (session lacks the lxd group)"
    exec sg lxd -c "\"$BIN\" ${ARGS[*]} \"$@\""
fi
if ! id -nG | grep -qw lxd; then
    echo "note: this session lacks the lxd group — fleet VMs will be invisible" \
         "(the 'self' VM still works). Log out and back in once to fix."
fi

exec "$BIN" "${ARGS[@]}" "$@"
