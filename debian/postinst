#!/bin/bash

if type update-alternatives 2>/dev/null >&1; then
    # Remove previous link if it doesn't use update-alternatives
    if [ -L '/usr/bin/hugpy-station' -a -e '/usr/bin/hugpy-station' -a "`readlink '/usr/bin/hugpy-station'`" != '/etc/alternatives/hugpy-station' ]; then
        rm -f '/usr/bin/hugpy-station'
    fi
    # Drop any stale alternative pointing at the raw binary (upgrade from <=1.0.12).
    update-alternatives --remove 'hugpy-station' '/opt/hugpy-station/hugpy-station' 2>/dev/null || true
    # Point the CLI at the launcher (not the raw Electron binary): the raw
    # binary crashes from a shell (zygote sandbox + space in path). The launcher
    # supplies --no-sandbox etc. and forwards "$@", so CLI == desktop behaviour.
    update-alternatives --install '/usr/bin/hugpy-station' 'hugpy-station' '/opt/hugpy-station/hugpy-station-launch' 100 || ln -sf '/opt/hugpy-station/hugpy-station-launch' '/usr/bin/hugpy-station'
else
    ln -sf '/opt/hugpy-station/hugpy-station-launch' '/usr/bin/hugpy-station'
fi

# SUID chrome-sandbox for Electron 5+
chmod 4755 '/opt/hugpy-station/chrome-sandbox' || true

# Domain hosting CLI + headless unit (see: hugpy-station-domain --help)
ln -sf '/opt/hugpy-station/resources/bin/hugpy-station-domain' /usr/bin/hugpy-station-domain
# Station builder on PATH for ssh/CLI use — its own name so a site layer's
# richer `vm-new` (which the console prefers when present) is never shadowed.
ln -sf '/opt/hugpy-station/resources/bin/vm-new' /usr/bin/fleet-vm-new
systemctl daemon-reload 2>/dev/null || true

if hash update-mime-database 2>/dev/null; then
    update-mime-database /usr/share/mime || true
fi

if hash update-desktop-database 2>/dev/null; then
    update-desktop-database /usr/share/applications || true
fi

# --- hugpy Station: ensure the installing desktop user can see fleet VMs ------
# The console talks to LXD over its unix socket, which requires membership in
# the 'lxd' group. Without it the launcher warns "fleet VMs will be invisible".
# Add the human who ran the install (best-effort, idempotent, never fatal).
add_to_lxd_group() {
    local u="$1"
    getent group lxd >/dev/null 2>&1 || return 0
    [ -n "$u" ] && [ "$u" != 'root' ] || return 0
    id "$u" >/dev/null 2>&1 || return 0
    if ! id -nG "$u" 2>/dev/null | tr ' ' '\n' | grep -qx lxd; then
        if usermod -aG lxd "$u" 2>/dev/null; then
            echo "hugpy-station: added '$u' to the 'lxd' group (log out/in once for it to take effect)"
        fi
    fi
}
if [ -n "${SUDO_USER:-}" ]; then
    add_to_lxd_group "$SUDO_USER"
else
    # Fallback: the first regular login account (uid 1000).
    add_to_lxd_group "$(getent passwd 1000 2>/dev/null | cut -d: -f1)"
fi

# --- hugpy Station: establish the ~/.hugpy runtime layout --------------------
# Station "mechanic" files (worker id/settings, model metadata, bugreport, …)
# live under a single base dir, HUGPY_HOME (default ~/.hugpy), split into
# state/ config/ logs/ run/. Create the skeleton at install so the first write
# lands correctly instead of strewing the home dir. Owned by the installing
# user; best-effort and never fatal.
# Map of every home-dir "mechanic" file -> its ~/.hugpy subdir. The private
# ones (worker id/settings, model_*) are handled in-code via HUGPY_HOME and are
# NOT listed here; these are the shared/interface files that other components,
# the read-only scripts, and cross-VM callers still open by their ~/ path.
HUGPY_LINK_MAP="state:todo.json:todo.json
state:todo-history.jsonl:todo-history.jsonl
run:.todo.lock:todo.lock
config:steward.json:steward.json
state:steward-state.json:steward-state.json
state:steward-request.json:steward-request.json
logs:bugreport.json:bugreport.json
logs:bugreport-request.json:bugreport-request.json
state:flow.json:flow.json
state:wireframe.json:wireframe.json
logs:.bridge-mail.jsonl:bridge-mail.jsonl"

ensure_hugpy_home() {
    local u="$1" h sub leg tgt legacy target
    [ -n "$u" ] && [ "$u" != 'root' ] || return 0
    h="$(getent passwd "$u" 2>/dev/null | cut -d: -f6)"
    [ -n "$h" ] && [ -d "$h" ] || return 0
    # 1. the organized skeleton
    for sub in state config logs run; do
        install -d -o "$u" -g "$u" -m 0755 "$h/.hugpy/$sub" 2>/dev/null || \
            mkdir -p "$h/.hugpy/$sub" 2>/dev/null || true
    done
    chown "$u:$u" "$h/.hugpy" 2>/dev/null || true
    # 2. compat symlinks: writes to ~/<f> land in ~/.hugpy/<sub>/<f>. Idempotent;
    #    a real legacy file is moved in first; a dangling link is fine (first
    #    write creates the target). Never clobbers an existing organized file.
    while IFS=: read -r sub leg tgt; do
        [ -n "$sub" ] || continue
        legacy="$h/$leg"; target="$h/.hugpy/$sub/$tgt"
        [ -L "$legacy" ] && continue
        if [ -e "$legacy" ]; then
            if [ ! -e "$target" ]; then
                mv "$legacy" "$target" 2>/dev/null && chown "$u:$u" "$target" 2>/dev/null
            else
                mv "$legacy" "$legacy.pre-hugpy" 2>/dev/null || true
            fi
        fi
        ln -sfn "$target" "$legacy" 2>/dev/null && chown -h "$u:$u" "$legacy" 2>/dev/null
    done <<EOF
$HUGPY_LINK_MAP
EOF
}
if [ -n "${SUDO_USER:-}" ]; then
    ensure_hugpy_home "$SUDO_USER"
else
    ensure_hugpy_home "$(getent passwd 1000 2>/dev/null | cut -d: -f1)"
fi

